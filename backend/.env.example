ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=mercato;Username=mercato;Password=mercato
ConnectionStrings__Mercato=Host=localhost;Port=5432;Database=mercato;Username=mercato;Password=mercato

Jwt__Issuer=Mercato.Api
Jwt__Audience=Mercato.Client
Jwt__Key=CHANGE_THIS_SECRET_TO_AT_LEAST_32_CHARACTERS

# Optional clean-install staff bootstrap. The account is created only when the email does not exist.
# Do not commit real production credentials.
BootstrapAdmin__Email=admin@mercato.local
BootstrapAdmin__Password=CHANGE_THIS_ADMIN_PASSWORD
